# Copy to .env.local and fill in values from https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Optional: a token with "Editor" rights so the contact form can create
# contactSubmission documents. Keep this server-side only (no NEXT_PUBLIC_).
SANITY_API_WRITE_TOKEN=
